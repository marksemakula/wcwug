# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# SMTP credentials used by the /api/contact and /api/event-registration
# serverless functions to email form submissions to info@winrise.org.
#
# These are server-only. Do NOT prefix them with VITE_ — Vite inlines any
# VITE_* variable into the client bundle, which would publish the password.
#
# Use the credentials for whichever mailbox should SEND these notifications.
# If info@winrise.org is on Google Workspace, generate an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) rather
# than using the account password.
#
# Set the same four values in Vercel:
#   Project -> Settings -> Environment Variables -> add for Production,
#   Preview and Development, then redeploy. Vercel does not read this file.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. The From address on the notification. Defaults to SMTP_USER.
# Many providers reject a From address the authenticated account does not own,
# so leave this blank unless you know the mailbox is allowed to send as it.
SMTP_FROM=
